{
  "name": "@viewpress/cli",
  "version": "0.1.0",
  "description": "Command-line interface for Viewpress",
  "type": "module",
  "scripts": {
    "build": "bun run scripts/build.ts",
    "build:native": "bun run scripts/build.ts --native",
    "check": "npm run typecheck && npm run lint && npm test && npm run docs:check",
    "docs:check": "bun run scripts/check-docs.ts",
    "lint": "eslint .",
    "release:checksums": "bun run scripts/write-checksums.ts",
    "smoke": "bun run scripts/smoke.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.1",
    "bun": "^1.3.14",
    "eslint": "^10.7.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0"
  },
  "dependencies": {
    "zod": "^4.4.3"
  }
}
